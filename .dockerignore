# Keep the build context small and the image free of anything the serving path doesn't need.
# (Everything here is either huge, secret-adjacent, or regenerated at runtime.)

.git
.github
.dvc
.dvcignore
**/.gitignore

# Environments & caches
venv/
venv-automl/
.conda/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Data: the container serves a pre-trained model, it never reads the dataset
data/
feast_repo/
outputs/

# Experiment tracking artifacts (regenerated by the training pipeline)
mlflow.db
mlruns/
catboost_info/
**/catboost_info/
*.log

# Notebooks, EDA output and docs — not part of the serving runtime
notebooks/
eda/
screenshots/
*.pdf
*.md

# Monitoring is run from the host against the container; its reports don't belong in the image
monitoring/reports/
monitoring/drifted/
monitoring/logs/

# The AutoML pickle needs PyCaret to unpickle and isn't what this image serves
models/model_automl.pkl
